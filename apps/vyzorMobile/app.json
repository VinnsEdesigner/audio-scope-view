{
  "expo": {
    "name": "Vyzorix Mobile",
    "slug": "vyzorix-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "vyzorix-mobile",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.vinns.vyzorix"
    },
    "android": {
      "package": "dev.vinns.vyzorix",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "INTERNET",
        "RECORD_AUDIO"
      ],
      "usesCleartextTraffic": true,
      "proguardRuleFile": "./proguard-rules.pro"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
