# Audio Scope View - Environment Variables
# This is the single source of truth for all environment configuration.
# Copy this file to .env and update values for your environment.

# ===========================================
# APPLICATION SETTINGS
# ===========================================

# Node.js environment
NODE_ENV=production
PORT=3000

# ===========================================
# RUST BACKEND CONFIGURATION
# ===========================================
# Double underscore (__) separator for nested config (parsed by config crate)

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Local SQLite (for development)
# APP__DATABASE__URL=sqlite:./data/audio_scope_view.db?mode=rwc

# Turso Cloud Database (for production)
# Get your database URL from: https://dashboard.turso.io/databases
# Format: libsql://your-database-xxx.turso.io
APP__DATABASE__URL=libsql://your-database-url.turso.io

# Turso Database Token (DB-scoped, NOT the platform API token)
# Create a database-scoped token via: turso db tokens create <db-name>
# Dashboard: Database → Manage → Database Tokens → Create New Token
# NOTE: The platform token (turso auth token) returns 401 against the DB API.
TURSO_VYZOR_SCOPE_DB_TOKEN=your-turso-database-token-here

# Server
APP__SERVER__HOST=127.0.0.1
APP__SERVER__PORT=8080

# GraphQL
APP__GRAPHQL__PLAYGROUND_ENABLED=true
APP__GRAPHQL__INTROSPECTION_ENABLED=true

# Audio
APP__AUDIO__BACKEND=mock

# Security
APP__SECURITY__REQUIRE_AUTH=true
APP__SECURITY__BOOTSTRAP_KEY=change-me-in-production

# Logging
APP__LOGGING__LEVEL=info

# ===========================================
# BOOTSTRAP KEY (REQUIRED)
# ===========================================
# Generate a secure random key (32+ characters recommended):
#   openssl rand -base64 32
# This key is used for:
# - Backend server authentication (BOOTSTRAP_KEY)
# - Frontend API client (VITE_BOOTSTRAP_KEY)
BOOTSTRAP_KEY=change-me-in-production

# ===========================================
# FRONTEND CONFIGURATION (Vite build-time)
# ===========================================
# These are embedded at build time for the frontend

# GraphQL Endpoint
VITE_GRAPHQL_ENDPOINT=/graphql

# WebSocket Endpoint for subscriptions
# Relative path is proxied by the static-server / reverse proxy to the Rust
# backend, so it works in Docker and remote deployments. Avoid absolute
# ws://localhost:8080 URLs — the browser's localhost is not the server.
VITE_WEBSOCKET_ENDPOINT=/ws

# Client URL - Used for CORS and callbacks
VITE_CLIENT_URL=http://localhost:3000

# ===========================================
# DOCKER/RENDER DEPLOYMENT
# ===========================================

# Rust backtrace
RUST_BACKTRACE=1
