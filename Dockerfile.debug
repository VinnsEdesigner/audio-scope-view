# Development/Debug Dockerfile for Audio Scope View
# Use this for local development with hot-reload capabilities

FROM node:22-alpine AS frontend-builder
WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@11.15.1 --activate

# Install dependencies first for better layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Build the project
RUN pnpm build && rm -f packages/api-client/tsconfig.tsbuildinfo && pnpm --filter @audio-scope-view/api-client build

# Development stage with hot reload
FROM node:22-alpine AS development
WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@11.15.1 --activate

# Install dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Expose ports
EXPOSE 3000 8080

# Start development servers
# The frontend dev server and Rust backend can be started separately
CMD ["sh", "-c", "echo 'Development mode - use docker-compose.debug.yml for full stack with hot-reload' && tail -f /dev/null"]
