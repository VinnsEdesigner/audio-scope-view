{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", ".output/**", "tsconfig.tsbuildinfo"]
    },
    "build:dev": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "build:wasm": {
      "cache": false,
      "outputs": ["packages/dsp-wasm/dist/**", "sdk/build/wasm/wasm/audioscope.{js,wasm}"]
    },
    "build:sdk": {
      "cache": false,
      "outputs": ["sdk/build/linux/**"]
    },
    "test:sdk": {
      "dependsOn": ["build:sdk"],
      "cache": false
    },
    "test": {
      "dependsOn": ["build:wasm"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
