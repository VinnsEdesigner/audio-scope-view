<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Session - Morning Lab Testing | Audio Scope View</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-primary: #1a1a1d;
      --bg-secondary: #212124;
      --bg-tertiary: #28282c;
      --bg-elevated: #2e2e33;
      --bg-hover: #35353b;
      --foreground: #f5f5f7;
      --text-secondary: #a1a1a6;
      --text-tertiary: #6e6e73;
      --border-subtle: rgba(255, 255, 255, 0.06);
      --border: rgba(255, 255, 255, 0.1);
      --border-hover: rgba(255, 255, 255, 0.15);
      --icon: #71717a;
      --accent-green: #22c55e;
      --accent-blue: #3b82f6;
      --accent-amber: #f59e0b;
      --accent-rose: #fb7185;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg-primary);
      color: var(--foreground);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
    }

    /* Hero Section */
    .hero {
      padding: 24px 32px;
      background: var(--bg-secondary);
      border-bottom: 1px solid var(--border-subtle);
    }

    .session-info {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .session-title-group { flex: 1; }

    .session-title {
      font-size: 24px;
      font-weight: 600;
      margin-bottom: 6px;
      color: var(--foreground);
    }

    .session-meta {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .meta-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: var(--text-secondary);
    }

    .meta-item svg {
      width: 14px;
      height: 14px;
      color: var(--icon);
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 8px;
      background: var(--bg-tertiary);
      border: 1px solid var(--border);
      border-radius: 4px;
      font-size: 11px;
      font-weight: 500;
      color: var(--text-secondary);
    }

    .status-badge.active {
      background: rgba(34, 197, 94, 0.15);
      border-color: rgba(34, 197, 94, 0.3);
      color: var(--accent-green);
    }

    .status-badge.active::before {
      content: '';
      width: 5px;
      height: 5px;
      background: var(--accent-green);
      border-radius: 50%;
      animation: pulse 1.5s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }

    .hero-actions {
      display: flex;
      gap: 6px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      padding: 6px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 500;
      border: none;
      cursor: pointer;
      background: var(--bg-tertiary);
      color: var(--text-secondary);
      border: 1px solid var(--border);
      transition: all 0.15s;
    }

    .btn:hover {
      background: var(--bg-elevated);
      color: var(--foreground);
      border-color: var(--border-hover);
    }

    .btn-primary {
      background: var(--accent-blue);
      color: white;
      border-color: var(--accent-blue);
    }

    .btn-primary:hover {
      background: #2563eb;
      border-color: #2563eb;
    }

    .btn svg { width: 14px; height: 14px; color: var(--icon); }
    .btn:hover svg { color: var(--foreground); }

    /* Main Content */
    .content {
      padding: 24px 32px;
    }

    /* Live Scope Session Details */
    .live-scope-section {
      background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-tertiary) 100%);
      border: 1px solid var(--accent-blue);
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 24px;
      position: relative;
      overflow: hidden;
    }

    .live-scope-section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--accent-blue), var(--accent-green), var(--accent-blue));
      background-size: 200% 100%;
      animation: gradient-shift 2s ease infinite;
    }

    @keyframes gradient-shift {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }

    .live-scope-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
    }

    .live-scope-title {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .live-scope-title h3 {
      font-size: 16px;
      font-weight: 600;
      color: var(--foreground);
    }

    .live-indicator {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      background: rgba(34, 197, 94, 0.15);
      border: 1px solid rgba(34, 197, 94, 0.3);
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
      color: var(--accent-green);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .live-indicator::before {
      content: '';
      width: 6px;
      height: 6px;
      background: var(--accent-green);
      border-radius: 50%;
      animation: pulse 1.5s ease-in-out infinite;
    }

    .live-scope-content {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 16px;
    }

    .live-scope-stat {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .live-scope-stat .stat-label {
      font-size: 11px;
      color: var(--text-tertiary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .live-scope-stat .stat-value {
      font-size: 18px;
      font-weight: 600;
      color: var(--foreground);
      font-family: ui-monospace, monospace;
    }

    .live-scope-stat .stat-value.capture-id {
      font-size: 12px;
      color: var(--accent-blue);
      letter-spacing: 0.5px;
    }

    .live-scope-stat .stat-value.duration {
      color: var(--accent-green);
    }

    .live-scope-stat .stat-value.sample-rate {
      color: var(--accent-amber);
    }

    .live-scope-stat .stat-value.status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent-green);
    }

    .status-dot.paused {
      background: var(--accent-amber);
    }

    .live-scope-stat .stat-sub {
      font-size: 10px;
      color: var(--text-tertiary);
      margin-top: 2px;
    }

    .live-actions {
      display: flex;
      gap: 6px;
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px solid var(--border-subtle);
    }

    /* Stats Row */
    .stats-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-bottom: 24px;
    }

    .stat-card {
      padding: 16px;
      background: var(--bg-secondary);
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
    }

    .stat-icon {
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--bg-tertiary);
      border-radius: 6px;
      margin-bottom: 10px;
    }

    .stat-icon svg { width: 14px; height: 14px; color: var(--icon); }

    .stat-value {
      font-size: 20px;
      font-weight: 600;
      color: var(--foreground);
      font-family: ui-monospace, monospace;
      margin-bottom: 3px;
    }

    .stat-label {
      font-size: 11px;
      color: var(--text-secondary);
    }

    /* Section */
    .section { margin-bottom: 20px; }

    .section-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--foreground);
      margin-bottom: 10px;
    }

    /* Session Details Card */
    .session-details-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
      padding: 16px;
      margin-bottom: 24px;
    }

    .session-details-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }

    .detail-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .detail-label {
      font-size: 11px;
      color: var(--text-tertiary);
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    .detail-value {
      font-size: 14px;
      font-weight: 500;
      color: var(--foreground);
    }

    /* Recordings Grid */
    .recordings-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
      gap: 12px;
    }

    .recording-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border-subtle);
      border-radius: 10px;
      padding: 16px;
      cursor: pointer;
      transition: all 0.15s;
    }

    .recording-card:hover {
      border-color: var(--border-hover);
      background: var(--bg-tertiary);
    }

    .recording-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 12px;
    }

    .recording-name {
      font-size: 14px;
      font-weight: 500;
      color: var(--foreground);
    }

    .recording-badge {
      padding: 3px 8px;
      border-radius: 4px;
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    .recording-badge.stereo {
      background: rgba(59, 130, 246, 0.15);
      color: var(--accent-blue);
    }

    .recording-badge.mono {
      background: rgba(168, 85, 247, 0.15);
      color: #a855f7;
    }

    .recording-badge.high-res {
      background: rgba(34, 197, 94, 0.15);
      color: var(--accent-green);
    }

    /* Measurement Grid */
    .measurements-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-bottom: 12px;
      padding: 12px;
      background: var(--bg-tertiary);
      border-radius: 8px;
    }

    .measurement-item {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .measurement-label {
      font-size: 10px;
      color: var(--text-tertiary);
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    .measurement-value {
      font-size: 14px;
      font-weight: 600;
      font-family: ui-monospace, monospace;
      color: var(--foreground);
    }

    .measurement-value.peak {
      color: var(--accent-rose);
    }

    .measurement-value.rms {
      color: var(--accent-blue);
    }

    .measurement-value.freq {
      color: var(--accent-amber);
    }

    .measurement-value.dc {
      color: var(--text-secondary);
    }

    /* Recording Meta Info */
    .recording-meta {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-bottom: 12px;
    }

    .meta-row {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--text-secondary);
    }

    .meta-row svg {
      width: 13px;
      height: 13px;
      color: var(--icon);
      flex-shrink: 0;
    }

    .meta-row .meta-value {
      color: var(--foreground);
      font-family: ui-monospace, monospace;
      font-size: 11px;
    }

    /* Min/Max Range Bar */
    .range-bar {
      height: 4px;
      background: var(--bg-hover);
      border-radius: 2px;
      margin-bottom: 12px;
      position: relative;
      overflow: hidden;
    }

    .range-fill {
      position: absolute;
      height: 100%;
      background: linear-gradient(90deg, var(--accent-blue), var(--accent-green));
      border-radius: 2px;
    }

    .range-labels {
      display: flex;
      justify-content: space-between;
      font-size: 10px;
      color: var(--text-tertiary);
      margin-top: 4px;
      font-family: ui-monospace, monospace;
    }

    /* Recording Footer */
    .recording-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 12px;
      border-top: 1px solid var(--border-subtle);
    }

    .recording-timestamp {
      font-size: 12px;
      color: var(--text-tertiary);
    }

    .recording-size {
      font-size: 13px;
      font-weight: 500;
      color: var(--text-secondary);
    }

    .recording-actions {
      display: flex;
      gap: 4px;
      opacity: 0;
      transition: opacity 0.15s;
    }

    .recording-card:hover .recording-actions {
      opacity: 1;
    }

    .action-btn {
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--bg-tertiary);
      border: 1px solid var(--border);
      border-radius: 5px;
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.15s;
    }

    .action-btn:hover {
      background: var(--bg-elevated);
      color: var(--foreground);
    }

    .action-btn svg { width: 13px; height: 13px; color: var(--icon); }
    .action-btn:hover svg { color: var(--foreground); }
  </style>
</head>
<body>
  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="session-info">
        <div class="session-title-group">
          <h1 class="session-title">Morning Lab Testing</h1>
          <div class="session-meta">
            <div class="meta-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              Jan 15, 2025
            </div>
            <div class="meta-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              9:00 AM
            </div>
            <span class="status-badge">Live</span>
          </div>
        </div>

        <div class="hero-actions">
          <button class="btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
            Edit
          </button>
          <button class="btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
            </svg>
            End Session
          </button>
        </div>
      </div>
    </section>

    <!-- Content -->
    <div class="content">
      <!-- Stats -->
      <div class="stats-row">
        <div class="stat-card">
          <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18V5l12-2v13"/>
              <circle cx="6" cy="18" r="3"/>
              <circle cx="18" cy="16" r="3"/>
            </svg>
          </div>
          <div class="stat-value">24</div>
          <div class="stat-label">Recordings</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <div class="stat-value">3h 45m</div>
          <div class="stat-label">Total Duration</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            </svg>
          </div>
          <div class="stat-value">156 MB</div>
          <div class="stat-label">Storage Used</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
          </div>
          <div class="stat-value">1h 20m</div>
          <div class="stat-label">Oscilloscope Time</div>
        </div>
      </div>

      <!-- Session Details -->
      <section class="section">
        <h2 class="section-title">Session Details</h2>
        <div class="session-details-card">
          <div class="session-details-grid">
            <div class="detail-item">
              <span class="detail-label">Session ID</span>
              <span class="detail-value">sess_abc123def</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Started</span>
              <span class="detail-value">Jan 15, 9:00 AM</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Last Activity</span>
              <span class="detail-value">2 minutes ago</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Live Capture</span>
              <span class="detail-value">Active • 2:45</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Recordings -->
      <section class="section">
        <h2 class="section-title">Recordings</h2>
        <div class="recordings-grid">
          <div class="recording-card">
            <div class="recording-name">Filter Test 2.4kHz</div>
            <div class="recording-meta">
              <div class="meta-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
                2m 30s
              </div>
              <div class="meta-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                  <line x1="8" y1="21" x2="16" y2="21"/>
                  <line x1="12" y1="17" x2="12" y2="21"/>
                </svg>
                44.1 kHz
              </div>
              <div class="meta-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                </svg>
                6.6M samples
              </div>
              <div class="meta-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                12.4 MB
              </div>
            </div>
            <div class="recording-footer">
              <span class="recording-size">Today at 12:45 PM</span>
              <div class="recording-actions">
                <button class="action-btn" title="Play">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="5 3 19 12 5 21 5 3"/>
                  </svg>
                </button>
                <button class="action-btn" title="View">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                </button>
                <button class="action-btn" title="Delete">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="3 6 5 6 21 6"/>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="recording-card">
            <div class="recording-name">Amplifier Gain Test</div>
            <div class="recording-meta">
              <div class="meta-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
                5m 12s
              </div>
              <div class="meta-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                  <line x1="8" y1="21" x2="16" y2="21"/>
                  <line x1="12" y1="17" x2="12" y2="21"/>
                </svg>
                48 kHz
              </div>
              <div class="meta-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                </svg>
                15.0M samples
              </div>
              <div class="meta-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                25.8 MB
              </div>
            </div>
            <div class="recording-footer">
              <span class="recording-size">Today at 12:30 PM</span>
              <div class="recording-actions">
                <button class="action-btn" title="Play">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="5 3 19 12 5 21 5 3"/>
                  </svg>
                </button>
                <button class="action-btn" title="View">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                </button>
                <button class="action-btn" title="Delete">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="3 6 5 6 21 6"/>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="recording-card">
            <div class="recording-name">Noise Floor Baseline</div>
            <div class="recording-meta">
              <div class="meta-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
                30s
              </div>
              <div class="meta-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                  <line x1="8" y1="21" x2="16" y2="21"/>
                  <line x1="12" y1="17" x2="12" y2="21"/>
                </svg>
                44.1 kHz
              </div>
              <div class="meta-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                </svg>
                1.3M samples
              </div>
              <div class="meta-row">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                1.2 MB
              </div>
            </div>
            <div class="recording-footer">
              <span class="recording-size">Today at 11:45 AM</span>
              <div class="recording-actions">
                <button class="action-btn" title="Play">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="5 3 19 12 5 21 5 3"/>
                  </svg>
                </button>
                <button class="action-btn" title="View">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                </button>
                <button class="action-btn" title="Delete">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="3 6 5 6 21 6"/>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
</body>
